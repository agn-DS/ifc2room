<Project>

  <PropertyGroup>
    <RevitYear>2023</RevitYear>
    <CompanyName>AGN</CompanyName>

    <TargetFramework>net481</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>agn.ifc2revitRooms</RootNamespace>
    <AssemblyName>agn_ifc2room</AssemblyName>

    <!-- einheitlicher Ausgabepfad pro Revit-Version -->
    <BaseOutputPath>bin\$(RevitYear)</BaseOutputPath>

    <!-- WPF/XAML -->
    <UseWPF>true</UseWPF>

  </PropertyGroup>

  <!-- zentrale Pfade/Targets -->
  <Import Project=".csproj/AllProjects.paths" />
  <Import Project=".csproj/AllProjects.base" />

  <ItemGroup>
    <!-- NuGet-Packages -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />

    <PackageReference Include="ManagedEsent" Version="1.9.4" />
    <PackageReference Include="Polybool.Net" Version="2.0.0" />

    <PackageReference Include="Microsoft.Extensions.Configuration" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="2.1.1" />

    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.4" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.3" />

    <!-- XBim -->
    <PackageReference Include="Xbim.Common" Version="5.1.341" />
    <PackageReference Include="Xbim.Ifc" Version="5.1.341" />
    <PackageReference Include="Xbim.Ifc2x3" Version="5.1.341" />
    <PackageReference Include="Xbim.Ifc4" Version="5.1.341" />
    <PackageReference Include="Xbim.IO.Esent" Version="5.1.341" />
    <PackageReference Include="Xbim.IO.MemoryModel" Version="5.1.341" />
    <PackageReference Include="Xbim.Tessellator" Version="5.1.341" />
    <PackageReference Include="Xbim.ModelGeometry.Scene" Version="5.1.437" />
    <PackageReference Include="Xbim.Geometry.Engine.Interop" Version="5.1.437" />
  </ItemGroup>

  <!-- Dateien, die nicht automatisch erkannt werden -->
  <ItemGroup>
    <None Include="agn_ifc2room.addin" CopyToOutputDirectory="Never" />
    <None Include="LICENSE" />
    <None Include="README.md" />
  </ItemGroup>

  <!-- Nach dem Build ins Revit-Bundle kopieren -->
  <Target Name="CopyToRevitBundle" AfterTargets="Build">
    <PropertyGroup>
      <BundleDir>$(AppData)\Autodesk\ApplicationPlugins\agn-apps_ifc2room.bundle\Contents\$(RevitYear)</BundleDir>
    </PropertyGroup>
    <Message Text="Kopiere Ausgabedateien nach '$(BundleDir)'" Importance="high" />
    <ItemGroup>
      <BuiltDlls Include="$(OutDir)*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(BundleDir)" />
    <Copy SourceFiles="@(BuiltDlls)" DestinationFolder="$(BundleDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>